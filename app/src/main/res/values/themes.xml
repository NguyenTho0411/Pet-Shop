<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Petshop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Petshop" parent="Base.Theme.Petshop" />

    <!-- Splash screen (no status bar) -->
    <style name="Theme.Petshop.Splash" parent="Base.Theme.Petshop">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/bg_main</item>
    </style>

    <!-- Auth screens -->
    <style name="Theme.Petshop.Auth" parent="Base.Theme.Petshop">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <!-- Input field style -->
    <style name="Widget.Petshop.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

    <!-- Orange button -->
    <style name="Widget.Petshop.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Outline button -->
    <style name="Widget.Petshop.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
