<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary"
        android:paddingStart="8dp" android:paddingEnd="16dp"
        android:paddingTop="44dp" android:paddingBottom="14dp">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Quay lại" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Quản lý hoàn trả"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="10dp" android:paddingBottom="10dp"
        android:background="@color/bg_card">
        <com.google.android.material.chip.ChipGroup android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipAll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tất cả" android:layout_marginEnd="8dp" android:checked="true"
                app:chipBackgroundColor="@color/primary" android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip android:id="@+id/chipPending"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Chờ duyệt" android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip android:id="@+id/chipApproved"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Đã duyệt" android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip android:id="@+id/chipRefunded"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Đã hoàn tiền" android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip android:id="@+id/chipRejected"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Từ chối"
                style="@style/Widget.MaterialComponents.Chip.Action" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView android:id="@+id/tvEmpty"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Không có yêu cầu hoàn trả nào"
        android:textSize="14sp" android:textColor="@color/text_hint"
        android:visibility="gone" />

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReturns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:clipToPadding="false" />

</LinearLayout>
