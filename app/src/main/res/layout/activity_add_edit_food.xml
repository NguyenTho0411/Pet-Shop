<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:paddingStart="8dp" android:paddingEnd="16dp"
        android:paddingTop="44dp" android:paddingBottom="12dp">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />
        <TextView android:id="@+id/tvTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm thức ăn"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btnSave"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="Lưu"
            android:textColor="@color/primary"
            android:background="@color/white"
            android:paddingStart="16dp" android:paddingEnd="16dp" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="match_parent" android:layout_height="4dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:visibility="gone" android:max="100" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Media section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📷 Ảnh &amp; Video" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedia"
                android:layout_width="match_parent" android:layout_height="110dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginBottom="20dp" />

            <!-- Basic info section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ℹ️ Thông tin cơ bản" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName" style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Tên thức ăn *" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategory" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Danh mục *" android:layout_marginBottom="12dp">
                <AutoCompleteTextView android:id="@+id/actvCategory"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilType" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Loại thức ăn" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etType" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWeight" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Trọng lượng (kg)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWeight" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBrand" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Thương hiệu" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBrand" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrigin" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Xuất xứ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrigin" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Description section -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📝 Mô tả chi tiết" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDesc" style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Mô tả sản phẩm" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDesc" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="3"
                    android:gravity="top" android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNutrition" style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Thành phần dinh dưỡng" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNutrition" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="2"
                    android:gravity="top" android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsage" style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Hướng dẫn sử dụng" android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="2"
                    android:gravity="top" android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Price & Stock section -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💰 Giá &amp; Kho" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrice" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Giá bán (đ) *" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrice" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrigPrice" style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Giá gốc (đ)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrigPrice" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStock" style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Số lượng kho *" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStock" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="number"
                    android:text="0" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Nút lưu cố định ở dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="24dp"
        android:elevation="8dp">
        <Button
            android:id="@+id/btnSaveBottom"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="💾  LƯU THỨC ĂN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_orange_pill" />
    </LinearLayout>

</LinearLayout>
