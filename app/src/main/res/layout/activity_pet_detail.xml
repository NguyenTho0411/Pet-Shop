<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2">

    <!-- ===== TOP: Hero image with colored background ===== -->
    <FrameLayout
        android:id="@+id/flHero"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="#F5B5A0">

        <!-- Pet image gallery (ViewPager2) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpPetImages"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Fallback single image (shown if no media loaded) -->
        <ImageView
            android:id="@+id/ivPetHero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <!-- Dot indicator -->
        <LinearLayout
            android:id="@+id/llDotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="50dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Gradient overlay at bottom for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:background="#44000000" />

        <!-- Back button (top left) -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:layout_marginTop="44dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Favorite button (top right) -->
        <FrameLayout
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:layout_marginTop="44dp">
            <ImageView
                android:id="@+id/ivFavoriteIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite"
                app:tint="#FFAAAAAA" />
        </FrameLayout>

        <!-- Promotion badge -->
        <TextView
            android:id="@+id/tvSaleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:layout_marginTop="100dp"
            android:text="-20%"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_orange_pill"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ===== BOTTOM SHEET: scrollable white card ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="340dp"
        android:layout_marginBottom="80dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFFFF"
            android:paddingBottom="24dp">

            <!-- Handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Pet name + status badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pet Name: Luna"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Còn hàng"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tag_status"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- Distance row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/text_secondary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvSpeciesBreed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siberian Husky · 3 tuổi · Đực"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- ===== Three attribute chips ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="22dp">

                <!-- Sex chip (purple) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_tag_attr"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/tvAttrGenderVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Male"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#6B5CE7" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giới tính"
                        android:textSize="11sp"
                        android:textColor="#9E96D8" />
                </LinearLayout>

                <!-- Age chip (yellow) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFF3D4"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/tvAttrAgeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 năm"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#B07800" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuổi"
                        android:textSize="11sp"
                        android:textColor="#C9A040" />
                </LinearLayout>

                <!-- Breed chip (green) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#D4F5E2">
                    <TextView
                        android:id="@+id/tvAttrBreedVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Husky"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1A7A46"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giống"
                        android:textSize="11sp"
                        android:textColor="#50B87A" />
                </LinearLayout>
            </LinearLayout>

            <!-- Price section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.000.000đ"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />
                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Weight + Origin -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 kg"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvOrigin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Việt Nam"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp" />

            <!-- About section -->
            <TextView
                android:id="@+id/tvAboutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Luna"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mô tả về thú cưng sẽ hiển thị ở đây..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Health & Care section -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💉 Sức khoẻ"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingStart="20dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvVaccine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💉 Vaccine đầy đủ"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tvDewormed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Đã tẩy giun"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvMicrochip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 Gắn chip"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tvCertificate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Có giấy tờ"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Care guide -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="20dp" android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 Hướng dẫn nuôi"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingStart="20dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCareGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDietInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== BOTTOM ACTION BAR (fixed) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="8dp">

        <!-- Phone button -->
        <FrameLayout
            android:id="@+id/btnCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_phone" />
        </FrameLayout>

        <!-- Chat button -->
        <FrameLayout
            android:id="@+id/btnChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_dark"
            android:layout_marginEnd="16dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat"
                android:padding="1dp" />
        </FrameLayout>

        <!-- "I Want It" main CTA -->
        <Button
            android:id="@+id/btnBuy"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Tôi muốn mua"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_orange_pill"
            android:drawableStart="@drawable/ic_paw"
            android:drawablePadding="8dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
