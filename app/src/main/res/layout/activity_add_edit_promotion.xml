<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:paddingStart="8dp" android:paddingEnd="16dp"
        android:paddingTop="44dp" android:paddingBottom="12dp">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />
        <TextView android:id="@+id/tvTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm khuyến mãi"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginStart="4dp" />
        <TextView android:id="@+id/btnSave"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LƯU"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/white"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="match_parent" android:layout_height="4dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:visibility="gone" android:max="100" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Tên khuyến mãi -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Tên khuyến mãi *" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mô tả -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Mô tả" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDesc" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="2"
                    android:gravity="top" android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Loại promotion: Voucher vs Automatic -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loại khuyến mãi *" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="6dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeVoucher"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:text="🎟️ VOUCHER"
                    android:layout_marginEnd="8dp" android:textSize="12sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeAutomatic"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:text="⚡ TỰ ĐỘNG"
                    android:textSize="12sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>

            <!-- Mã voucher (chỉ hiện khi chọn VOUCHER) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutVoucherCode"
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Mã voucher *" android:layout_marginBottom="12dp"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVoucherCode" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Loại giảm giá -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loại giảm giá *" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="6dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypePercent"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:text="% PHẦN TRĂM"
                    android:layout_marginEnd="8dp" android:textSize="12sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeFixed"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:text="₫ SỐ TIỀN CỐ ĐỊNH"
                    android:textSize="12sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>

            <!-- Mức giảm -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Mức giảm *" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDiscountValue" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Tối đa giảm">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxDiscount" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Đơn tối thiểu (chỉ hiện khi là Voucher) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMinOrder"
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Đơn hàng tối thiểu (đ)"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMinOrder" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== ÁP DỤNG CHO ===== -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Áp dụng cho *" android:textSize="13sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" android:layout_marginTop="8dp" />

            <!-- Bước 1: Chọn loại áp dụng -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyAll"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="TẤT CẢ"
                    android:layout_marginEnd="4dp" android:textSize="10sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyCategory"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="THEO DANH MỤC"
                    android:layout_marginEnd="4dp" android:textSize="10sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplySpecies"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="THEO GIỐNG"
                    android:layout_marginEnd="4dp" android:textSize="10sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyProduct"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="SẢN PHẨM CỤ THỂ"
                    android:textSize="10sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>

            <!-- Bước 2: Chọn danh mục (khi chọn THEO DANH MỤC) -->
            <LinearLayout android:id="@+id/layoutCategoryChoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCatPet"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="🐾 THÚ CƯNG"
                    android:layout_marginEnd="8dp" android:textSize="11sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCatFood"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="🍖 THỨC ĂN"
                    android:textSize="11sp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <!-- Bước 2: Chọn giống (khi chọn THEO GIỐNG) -->
            <LinearLayout android:id="@+id/layoutSpeciesChoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chọn giống áp dụng:" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDog"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐕 Chó" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCat"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐈 Mèo" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFish"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐟 Cá" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBird"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐦 Chim" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRabbit"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐰 Thỏ" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHamster"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐹 Hamster" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Bước 2: Chọn sản phẩm cụ thể -->
            <LinearLayout android:id="@+id/layoutProductChoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chọn sản phẩm áp dụng:" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Chọn sản phẩm"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <TextView android:id="@+id/tvSelectedProducts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Chưa chọn sản phẩm nào"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="4dp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Ngày áp dụng -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Ngày bắt đầu *" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStartDate" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="date" android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Ngày kết thúc *">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEndDate" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="date" android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Giới hạn sử dụng -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Mỗi khách dùng" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxPerUser" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="number" android:text="999" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Tổng lượt dùng">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotalLimit" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="number" android:text="9999" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="12dp" android:paddingBottom="24dp"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBottom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="💾  LƯU KHUYẾN MÃI"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/primary"
            android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>
</LinearLayout>
