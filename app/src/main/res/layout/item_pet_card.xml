<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#F5A623"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Full-card container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top content: left info + right image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- LEFT: info block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Distance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textSize="10sp"
                    android:textColor="#FFEDD0"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.9 km nearby"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <!-- Tags label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tags"
                    android:textSize="10sp"
                    android:textColor="#FFEDD0"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTag1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good with Kids"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTag2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energetic"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvTag3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loyal"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- RIGHT: pet image fills right half -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Orange circle backdrop behind image -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_circle_orange"
                    android:alpha="0.5"
                    android:layout_marginEnd="-16dp" />

                <ImageView
                    android:id="@+id/ivPetImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />

                <!-- Status Badge on Image -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_orange_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Đã bán"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>

        <!-- BOTTOM info bar (overlays on top) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#CC1C1C1E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:justificationMode="inter_word">

            <!-- Name + price row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pet name: Luna"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$820"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/ivAddToCart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="@drawable/bg_circle_orange"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Breed · age · gender -->
            <TextView
                android:id="@+id/tvBreedInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siberian Husky · Adult · Male"
                android:textSize="10sp"
                android:textColor="#CCFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </FrameLayout>
</androidx.cardview.widget.CardView>
