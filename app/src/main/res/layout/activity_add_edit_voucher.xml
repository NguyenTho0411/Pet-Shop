<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:paddingStart="8dp" android:paddingEnd="16dp"
        android:paddingTop="44dp" android:paddingBottom="12dp">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />
        <TextView android:id="@+id/tvTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thêm voucher"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginStart="4dp" />
        <Button android:id="@+id/btnSave"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="Lưu"
            android:textColor="@color/primary"
            android:background="@color/white"
            android:paddingStart="16dp" android:paddingEnd="16dp" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="match_parent" android:layout_height="4dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:visibility="gone" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Mã voucher (Vd: SUMMER2024) *" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCode" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="text"
                    android:textAllCaps="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Tên (Vd: Summer discount)" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loại giảm giá *" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypePercent"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="% Phần trăm"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Petshop.Button.Primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeFixed"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="₫ Số tiền cố định"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Petshop.Button.Outline" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeShip"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="🚚 Miễn ship"
                    style="@style/Widget.Petshop.Button.Outline" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Mức giảm *" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etValue" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Tối đa giảm">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxDiscount" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Petshop.TextInput"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Đơn tối thiểu (tuỳ chọn)" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMinOrder" android:layout_width="match_parent"
                    android:layout_height="56dp" android:inputType="numberDecimal" android:text="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Ngày bắt đầu *" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStartDate" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="date" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Ngày kết thúc *">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEndDate" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="date" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Max/user" android:layout_marginEnd="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPerUserLimit" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="number" android:text="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Petshop.TextInput"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="Tổng limit *">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsageLimit" android:layout_width="match_parent"
                        android:layout_height="56dp" android:inputType="number" android:text="1000" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
